DATABASE_URL=postgres://...
JWT_SECRET=your-secret-here-min-32-chars
FOUNDER_EMAIL=olagbayebenz@gmail.com
CRON_SECRET=your-cron-secret-here
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_SITE_URL=https://www.wissenhaus.org

# Optional: error tracking. Sentry stays fully inert until SENTRY_DSN /
# NEXT_PUBLIC_SENTRY_DSN are set (init() runs with dsn: undefined, which
# the SDK treats as disabled). SENTRY_ORG/PROJECT/AUTH_TOKEN are only
# needed in CI to upload source maps on build.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: Telegram command center (docs/TELEGRAM_BOT.md). The webhook route
# returns 503 until TELEGRAM_BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET are both set.
# TELEGRAM_ADMINS links Telegram user IDs to admin accounts: id:email,id:email
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMINS=
