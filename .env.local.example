# Optional: error tracking. Sentry stays fully inert until SENTRY_DSN /
# NEXT_PUBLIC_SENTRY_DSN are set (init() runs with dsn: undefined, which
# the SDK treats as disabled). SENTRY_ORG/PROJECT/AUTH_TOKEN are only
# needed in CI to upload source maps on build.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
