  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime and edge",
      "items": [
        "Next.js 15.3 App Router, React 19; all handlers on the default Node runtime.",
        "/ingest/* is rewritten to eu.i.posthog.com so analytics stay first-party."
      ]
    },
    {
      "dot": "emerald",
      "title": "Data plane",
      "items": [
        "Neon serverless Postgres; lib/db.ts connects on first query, not at import.",
        "8 tables; schema applied by hand via scripts/migrate.mjs, no migration history."
      ]
    },
    {
      "dot": "violet",
      "title": "Primary path",
      "items": [
        "1-3: browser POSTs /api/payments/stripe; lib/stripe.ts creates a Checkout Session.",
        "4-6: /donate/success PUTs the id back; recordDonation writes, mails, tracks."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Middleware only checks the cookie; JWT verify runs in layouts and handlers.",
        "donation-projects guards on session.isAdmin, a claim signToken never issues."
      ]
    },
    {
      "dot": "amber",
      "title": "Scheduled ingest",
      "items": [
        "Two triggers on one 17 3 * * * schedule: vercel.json cron and GitHub Actions.",
        "Six public feeds incl. RemoteOK, Himalayas, Devpost, ScholarshipsForAfricans."
      ]
    },
    {
      "dot": "slate",
      "title": "Gaps to review",
      "items": [
        "No Stripe webhook: an abandoned redirect leaves a paid donation unrecorded.",
        "deploy.yml targets a missing redesign/ dir; real deploys come from Vercel Git."
      ]
    }
  ]
}